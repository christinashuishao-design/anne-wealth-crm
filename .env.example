# Supabase 项目设置 > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 首次执行 pnpm db:seed 时使用，不会写入仓库
SEED_ADMIN_EMAIL=anne@example.com
SEED_ADMIN_PASSWORD=replace-with-a-strong-password

# 定时任务调用 /api/cron/reminders 时携带 Authorization: Bearer <CRON_SECRET>
CRON_SECRET=replace-with-a-long-random-secret

# 通信同步：密钥只保存在 Cloudflare Worker Secrets，不要提交到 Git。
COMMUNICATION_SYNC_SECRET=replace-with-a-long-random-secret
# JSON：每个来发信/企业邮箱来源对应一个只读 HTTPS 连接器。连接器只能读取并回调 /api/communications/ingest。
COMMUNICATION_CONNECTORS_JSON={}
# Meta WhatsApp Business Cloud API（两个号码共用 webhook，也可来自不同 WABA）。
WHATSAPP_VERIFY_TOKEN=replace-with-a-long-random-token
WHATSAPP_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID_1=
WHATSAPP_PHONE_NUMBER_ID_2=

# 产品截图价格识别（仅服务端 Cloudflare Secret）
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1-mini
NEXT_PUBLIC_APP_URL=http://localhost:3000
